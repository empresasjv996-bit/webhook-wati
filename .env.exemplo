# Acrescente estas duas linhas ao seu .env existente.
# ATENÇÃO: não substitua o arquivo — ele já contém DATABASE_URL.
# O .env está no .gitignore e nunca deve ser enviado para o Git.
EXTRATOR_USUARIO=seu-usuario
EXTRATOR_SENHA=sua-senha

# DeepSeek (API compatível com a da OpenAI — veja deepseek.js)
DEEPSEEK_API_KEY=sk-sua-chave
# Opcional: deepseek-flash (padrão) ou deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash

# Opcional: quantos contatos de template vão juntos numa campanha da Wati
# (padrão 200, máximo 500). O intervalo da campanha passa a valer entre lotes.
WATI_LOTE_TEMPLATE=200

# Verificação SpyHub (aba Contatos): login do app.spyhub.io usado pelo
# motor que confere se o CPF tem telefone terminando nos 4 dígitos.
SPYHUB_USUARIO=seu-usuario
SPYHUB_SENHA=sua-senha

# Opcional: porta CDP do Chrome dedicado do SpyHub (não conflita com o extrator)
# CDP_PORT_SPYHUB=9226
# Opcional: tentativas por CPF, pausa entre consultas e teto de registros por job
# SPYHUB_TENTATIVAS=3
# SPYHUB_INTERVALO_MS=1200
# SPYHUB_ESPERA_RESULTADO=25000
# SPYHUB_MAX_REGISTROS=500
# Opcional: rodar sem janela. Compartilhado com o extrator (o login com captcha
# costuma exigir janela visível no Windows).
# EXTRATOR_HEADLESS=1
# Opcional: URL alternativa do painel/busca
# SPYHUB_URL=https://app.spyhub.io
# SPYHUB_LOGIN_URL=https://app.spyhub.io/login
# Módulos de consulta (100 consultas em CADA URL). O motor usa na ordem e, quando
# um estoura a cota, repete o mesmo CPF no seguinte — não precisa mexer aqui.
# Padrão: /search/tracker -> /search/cpf-top -> /search/avancada
# (o Tracker é o que devolve o número certo; o avancada fica só como reserva)
# SPYHUB_MODULOS_URLS=https://app.spyhub.io/search/tracker,https://app.spyhub.io/search/cpf-top,https://app.spyhub.io/search/avancada
# SPYHUB_BUSCA_URL=https://app.spyhub.io/search/tracker
# SPYHUB_COTA_MODULO=100
# SPYHUB_REVALIDAR_MODULO_MS=600000

